# Food Manufacturing Management System
# Backend environment configuration template
#
# Copy this file to backend/.env for local development.
# Replace all placeholder values with your own configuration.
#
# Never commit backend/.env or actual credentials to Git.
# Configure production secrets through Render environment variables.


# ------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------

# Supported environments: development, testing, production
ENVIRONMENT=development

# Enables localhost-only evaluator login buttons. Keep false in production.
DEMO_MODE=false

# Local FastAPI server port.
# Render supplies its own PORT environment variable.
PORT=8000


# ------------------------------------------------------------
# Supabase PostgreSQL Database
# ------------------------------------------------------------

# SQLAlchemy connection URL using Psycopg 3.
#
# Replace the placeholders with your Supabase PostgreSQL
# connection details.
#
# Use the appropriate Supabase connection endpoint for your
# deployment environment.
#
# URL-encode special characters in the database password.
# Do not use a Supabase API key as the PostgreSQL password.
#
# SSL is required for connections to Supabase PostgreSQL.

DATABASE_URL=postgresql+psycopg://YOUR_DATABASE_USER:YOUR_URL_ENCODED_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require


# ------------------------------------------------------------
# Authentication and JWT Configuration
# ------------------------------------------------------------

# Replace this placeholder with a cryptographically secure,
# randomly generated secret before running the application.
#
# Use a different secret for development and production.
# Never expose the secret in frontend code.

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY

# JWT signing algorithm.
ALGORITHM=HS256

# Access token expiration in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------

# JSON array of explicitly permitted frontend origins.
#
# Local development uses the default Vite development server.
# Add your actual Vercel frontend URL when deploying.
#
# Do not use wildcard origins for authenticated requests.
# Do not include trailing slashes in origin values.

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
