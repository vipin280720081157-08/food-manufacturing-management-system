# FastAPI backend base URL, including the API version prefix.
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production:
# Set VITE_API_BASE_URL to the deployed Render backend API URL.
# Example: https://<render-service-name>.onrender.com/api/v1

# Only public, non-sensitive configuration may use the VITE_ prefix.
# Database credentials, Supabase service-role keys, JWT signing secrets,
# and other backend secrets must never be stored in frontend environment files.